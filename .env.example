# FirstCommit Configuration Template
# Copy this file to .env and fill in optional values.

# Optional: Fine-grained GitHub read-only token to expand rate limit from 60 to 5,000 requests/hour
# Permissions needed: Public Repositories (Read-only)
GITHUB_TOKEN=your_fine_grained_github_pat_here

# OpenRouter API Key (Powers Gemini 2.5 Flash, GPT-4o-mini, Claude Haiku 4.5, and Llama 3.3)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Switch & Mattermost Settings
MATTERMOST_URL=http://localhost:60922
SWITCH_API_ENDPOINT=http://127.0.0.1:63242
